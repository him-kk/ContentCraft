# Backend environment variables (example)
# Copy to .env and fill in values. Do not commit .env.

# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me

# Text AI provider
# Options: bedrock | gemini
AI_TEXT_PROVIDER=bedrock

# AWS Bedrock (recommended)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# If running locally without an AWS profile/role, you can provide credentials via env vars.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Legacy / fallback providers
# GEMINI_API_KEY=
# OPENAI_API_KEY=
