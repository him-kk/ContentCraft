# AWS DocumentDB environment variables (example)
# Copy to backend/.env and fill in values. Do not commit backend/.env.

# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me

# --- DocumentDB ---
# DocumentDB runs inside a VPC. Your app must have network access to the cluster
# (same VPC / VPC peering / VPN / SSH tunnel / etc.) and SG rules must allow 27017.

# Option A (most common for this repo today): set a full MongoDB connection string.
# `backend/config/db.js` uses MONGODB_URI.
# Notes:
# - DocumentDB typically requires TLS.
# - Use retryWrites=false for compatibility.
# - replicaSet=rs0 and readPreference=secondaryPreferred are common defaults.
# - If your password contains special characters, URL-encode it.
MONGODB_URI=mongodb://your_db_user:your_db_password@your-docdb-cluster.cluster-xxxxxxxxxxxx.us-east-1.docdb.amazonaws.com:27017/contentcraft?tls=true&tlsCAFile=./config/global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# Option B (if you switch the server to use backend/config/documentdb.js):
# That module expects DOCUMENTDB_* variables and can build the URI for you.
DOCUMENTDB_URI=
DOCUMENTDB_HOST=your-docdb-cluster.cluster-xxxxxxxxxxxx.us-east-1.docdb.amazonaws.com
DOCUMENTDB_PORT=27017
DOCUMENTDB_USERNAME=your_db_user
DOCUMENTDB_PASSWORD=your_db_password
DOCUMENTDB_DATABASE=contentcraft
DOCUMENTDB_REPLICA_SET=rs0
DOCUMENTDB_READ_PREFERENCE=secondaryPreferred

# TLS settings used by backend/config/documentdb.js
DOCUMENTDB_TLS=true
DOCUMENTDB_CA_FILE=./config/global-bundle.pem

# Optional (not recommended unless you understand the risk)
DOCUMENTDB_TLS_ALLOW_INVALID_CERTS=false
DOCUMENTDB_TLS_ALLOW_INVALID_HOSTNAMES=false

# Optional timeout tuning
DOCUMENTDB_SERVER_SELECTION_TIMEOUT_MS=10000

# If you still want Redis (optional)
# REDIS_ENABLED=false
# REDIS_URL=redis://localhost:6379
